# Discord Bot Credentials (copy to .dev.vars — never commit .dev.vars)
DISCORD_TOKEN=your-bot-token-here
DISCORD_PUBLIC_KEY=your-public-key-here
DISCORD_APPLICATION_ID=your-application-id-here

# Together AI (get a free key at together.ai)
TOGETHER_API_KEY=your-together-api-key-here

# Channel Configuration
RESEARCH_CHANNEL_ID=your-research-channel-id
DISCUSSION_CHANNEL_ID=your-discussion-channel-id
PULSE_CHANNEL_ID=your-pulse-output-channel-id

# Community Pulse — comma-separated list of channel IDs the bot reads for pulse analysis
# Only channels explicitly listed here will be read. No other channels are accessed.
PULSE_SOURCE_CHANNEL_IDS=channel-id-1,channel-id-2,channel-id-3

# Optional: separate channel for industry/trade news (not flower-focused)
# INDUSTRY_CHANNEL_ID=your-industry-channel-id
